            "state": "translated",
            "value": "Перекласти за допомогою Mwoyeo"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy prompt for the local network",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo connects to a translation server on your network only if you add one as an engine."
          }
        },
