    "%@ uses only names swapped into the text; %lld here are not.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ verwendet nur Namen, die in den Text eingesetzt werden; %lld hier nicht."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ verwendet nur Namen, die in den Text eingesetzt werden; %lld hier nicht."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
