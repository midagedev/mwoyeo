    "The conversation kept for this app is forgotten. Your note, names and learned terms stay.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에 대해 기억한 대화를 지웁니다. 메모, 이름, 배운 용어는 남습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリで記憶した会話を消去します。メモ、名前、学習した用語は残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此应用保留的对话将被忘记。你的备注、名称和已学术语会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為此 App 保留的對話將被忘記。你的備註、名稱和已學術語會保留。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das für diese App gemerkte Gespräch wird vergessen. Ihre Notiz, Ihre Namen und die gelernten Begriffe bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation conservée pour cette app est oubliée. Votre note, vos noms et les termes appris sont gardés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se olvida la conversación guardada para esta app. Tu nota, los nombres y los términos aprendidos se conservan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диалог, сохранённый для этого приложения, будет забыт. Ваша заметка, имена и выученные термины останутся."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa guardada para este app será esquecida. Sua nota, os nomes e os termos aprendidos permanecem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversazione conservata per questa app viene dimenticata. La tua nota, i nomi e i termini appresi restano."
          }
