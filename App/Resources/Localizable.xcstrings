    "Change the text on this Mac, free: the original before it is translated, or the translation after.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern Sie den Text auf diesem Mac, kostenlos: das Original vor dem Übersetzen oder die Übersetzung danach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el texto en este Mac, gratis: el original antes de traducirlo o la traducción después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez le texte sur ce Mac, gratuitement : l’original avant sa traduction, ou la traduction après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica il testo su questo Mac, gratis: l’originale prima della traduzione o la traduzione dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMac上でテキストを無料で書き換えます。翻訳前の原文、または翻訳後の訳文を対象にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 무료로 글자를 바꿉니다. 번역 전에는 원문을, 번역 후에는 번역문을 바꿉니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere o texto neste Mac, de graça: o original antes de ser traduzido ou a tradução depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте текст на этом Mac бесплатно: оригинал до перевода или перевод после."
