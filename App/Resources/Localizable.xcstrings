          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透镜读到的文字会发送到 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透鏡讀到的文字會傳送到 %@。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, den die Linse liest, wird an %@ gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte lu par la loupe est envoyé à %@."
          }
        },
        "es": {
