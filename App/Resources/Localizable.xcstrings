    "%@ gets only the line, whatever a profile asks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erhält nur die Zeile, egal was ein Profil verlangt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recibe solo la línea, pida lo que pida un perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne reçoit que la ligne, quoi que demande un profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ riceve solo la riga, qualunque cosa chieda un profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルの設定にかかわらず、%@ には行だけが送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 프로필 설정과 상관없이 해당 줄만 보냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recebe só a linha, não importa o que um perfil peça."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ получает только строку, что бы ни просил профиль."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отримує лише рядок, що б не просив профіль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论配置文件如何设置，%@ 都只会收到该行文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論設定檔如何設定，%@ 都只會收到該行文字。"
          }
        }
      }
    },
