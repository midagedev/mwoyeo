    "Each lens writes what it reads and its translation to Markdown and SRT files.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈마다 읽은 원문과 번역을 Markdown과 SRT 파일로 남겨요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズごとに、読み取った原文と翻訳をMarkdownとSRTファイルに書き出します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个透镜会把读到的原文和译文写入 Markdown 和 SRT 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個透鏡會把讀到的原文和譯文寫入 Markdown 和 SRT 檔案。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Linse schreibt, was sie liest, samt Übersetzung in Markdown- und SRT-Dateien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque loupe écrit ce qu’elle lit et sa traduction dans des fichiers Markdown et SRT."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada lupa escribe lo que lee y su traducción en archivos Markdown y SRT."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая линза записывает прочитанное и перевод в файлы Markdown и SRT."
          }
        },
