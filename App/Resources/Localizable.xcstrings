    },
    "The fastest translation when a language pack is installed, Apple Intelligence otherwise": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 팩이 있으면 가장 빠른 번역, 없으면 Apple Intelligence 번역"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語パックがあれば最速の翻訳、なければApple Intelligenceで翻訳"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装了语言包时翻译最快，否则使用 Apple Intelligence"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝了語言包時翻譯最快，否則使用 Apple Intelligence"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die schnellste Übersetzung, wenn ein Sprachpaket installiert ist, sonst Apple Intelligence"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction la plus rapide si un pack de langue est installé, sinon Apple Intelligence"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción más rápida si hay un paquete de idioma instalado; si no, Apple Intelligence"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самый быстрый перевод, если установлен языковой пакет, иначе — Apple Intelligence"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução mais rápida quando há um pacote de idioma instalado; senão, Apple Intelligence"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione più veloce se è installato un pacchetto lingua, altrimenti Apple Intelligence"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найшвидший переклад, якщо встановлено мовний пакет, інакше — Apple Intelligence"
          }
        }
      }
    },
    "The key could not be saved to the Keychain.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 키체인에 저장하지 못했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをキーチェーンに保存できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将密钥存储到钥匙串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將金鑰儲存到鑰匙圈。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel konnte nicht im Schlüsselbund gesichert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la clé dans le trousseau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la clave en el llavero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить ключ в Связке ключей."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a chave nas Chaves."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la chiave nel Portachiavi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти ключ у Зв’язці ключів."
          }
        }
      }
    },
    "The model is still downloading": {
      "localizations": {
        "ko": {
