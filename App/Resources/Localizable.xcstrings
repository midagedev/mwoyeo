    "Needed to read the text under a lens. You may have to reopen Mwoyeo after allowing it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈 아래 글자를 읽으려면 필요해요. 허용한 뒤 앱을 다시 열어야 할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズの下のテキストを読み取るために必要です。許可したあと、Mwoyeoを開き直す必要がある場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于读取透镜下方的文字。允许后可能需要重新打开 Mwoyeo。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於讀取透鏡下方的文字。允許後可能需要重新打開 Mwoyeo。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderlich, um den Text unter einer Linse zu lesen. Nach dem Erlauben müssen Sie Mwoyeo eventuell erneut öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour lire le texte sous une loupe. Vous devrez peut-être rouvrir Mwoyeo après l’autorisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para leer el texto bajo una lupa. Puede que tengas que volver a abrir Mwoyeo tras permitirlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, чтобы читать текст под линзой. После разрешения Mwoyeo, возможно, придётся открыть заново."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para ler o texto sob uma lente. Talvez seja preciso reabrir o Mwoyeo depois de permitir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessario per leggere il testo sotto una lente. Dopo aver consentito, potrebbe essere necessario riaprire Mwoyeo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен, щоб читати текст під лінзою. Після дозволу Mwoyeo, можливо, доведеться відкрити знову."
          }
        }
      }
    },
