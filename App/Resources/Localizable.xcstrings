    "Translates the screen in place, wherever you put a lens.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈를 올린 곳을, 그 자리에서 번역"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズを置いた場所を、その場で翻訳します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论透镜放在哪里，都就地翻译屏幕内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論透鏡放在哪裡，都就地翻譯螢幕內容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzt den Bildschirm an Ort und Stelle, wo immer Sie eine Linse platzieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduit l’écran sur place, partout où vous placez une loupe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce la pantalla en el mismo lugar, dondequiera que pongas una lupa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводит экран прямо на месте — там, где вы поместили линзу."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduz a tela no próprio lugar, onde quer que você posicione uma lente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce lo schermo sul posto, ovunque tu posizioni una lente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекладає екран прямо на місці — там, де ви розмістили лінзу."
          }
        }
      }
    },
