    "Text recognition isn’t fully ready.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 인식이 아직 다 준비되지 않았어요."
          }
        },
        "ja": {
          "stringUnit": {
