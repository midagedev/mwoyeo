    "A copy of settings.json could not be made, so the settings stay as they are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte keine Kopie von settings.json angelegt werden, daher bleiben die Einstellungen unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear una copia de settings.json, así que los ajustes se quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer une copie de settings.json ; les réglages restent donc inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile creare una copia di settings.json, quindi le impostazioni restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json のコピーを作成できなかったため、設定はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json의 사본을 만들지 못해 설정을 그대로 두었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível fazer uma cópia de settings.json, então os ajustes permanecem como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать копию settings.json, поэтому настройки остаются без изменений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося створити копію settings.json, тому налаштування залишаються без змін."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建 settings.json 的副本，因此设置保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立 settings.json 的副本，因此設定保持不變。"
          }
        }
      }
    },
    "A language name or code, such as Korean or ko. Empty uses the target language in Mwoyeo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sprachname oder -code, etwa Korean oder ko. Leer lässt die Zielsprache aus Mwoyeo gelten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre o código de idioma, como Korean o ko. Vacío usa el idioma de destino de Mwoyeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom ou un code de langue, comme Korean ou ko. Vide, la langue cible de Mwoyeo est utilisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome o codice di lingua, come Korean o ko. Se vuoto, usa la lingua di destinazione di Mwoyeo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「日本語」や ja のような言語名またはコードです。空のままにすると Mwoyeo の翻訳先の言語を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한국어나 ko처럼 언어 이름이나 코드예요. 비워 두면 Mwoyeo에 정한 번역 언어를 써요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome ou código de idioma, como Korean ou ko. Vazio usa o idioma de destino do Mwoyeo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название или код языка, например Korean или ko. Если пусто, берётся язык перевода из Mwoyeo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
