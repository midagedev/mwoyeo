          }
        }
      }
    },
    "Lets an agent such as Claude Code read the translation log, change settings and write each app’s memory.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 같은 에이전트가 번역 기록을 읽고, 설정을 바꾸고, 앱마다 메모리를 쓸 수 있게 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code などのエージェントが、翻訳ログを読み、設定を変え、アプリごとのメモリを書けるようにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Claude Code 等智能体读取翻译记录、更改设置，并写入每个应用的记忆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Claude Code 等智慧代理讀取翻譯記錄、更改設定，並寫入每個 App 的記憶。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt einem Agenten wie Claude Code, das Übersetzungsprotokoll zu lesen, Einstellungen zu ändern und das Gedächtnis jeder App zu schreiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à un agent comme Claude Code de lire le journal des traductions, de modifier les réglages et d’écrire la mémoire de chaque app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que un agente como Claude Code lea el registro de traducciones, cambie los ajustes y escriba la memoria de cada app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет агенту, например Claude Code, читать журнал переводов, менять настройки и записывать память каждого приложения."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que um agente como o Claude Code leia o registro de traduções, altere os ajustes e escreva a memória de cada app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente a un agente come Claude Code di leggere il registro delle traduzioni, cambiare le impostazioni e scrivere la memoria di ogni app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяє агентові, як-от Claude Code, читати журнал перекладів, змінювати налаштування й записувати пам’ять кожної програми."
          }
        }
      }
    },
