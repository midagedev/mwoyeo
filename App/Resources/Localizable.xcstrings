    "Seen once. Used after a second sighting.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 나왔습니다. 두 번째부터 씁니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回だけ見つかりました。2回目から使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只出现过一次。第二次出现后才会使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只出現過一次。第二次出現後才會使用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal gesehen. Wird ab dem zweiten Mal verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vu une fois. Utilisé à partir de la deuxième fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visto una vez. Se usa a partir de la segunda vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встретилось один раз. Применяется со второго раза."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visto uma vez. Usado a partir da segunda vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visto una volta. Usato dalla seconda volta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зустрілося один раз. Застосовується з другого разу."
