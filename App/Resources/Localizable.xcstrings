    "macOS is still preparing text recognition for %@. This can take a minute.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 아직 %@ 글자 인식을 준비하고 있어요. 1분쯤 걸릴 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSはまだ%@の文字認識を準備しています。1分ほどかかることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 仍在准备%@文字识别，可能需要一分钟左右。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 仍在準備%@文字辨識，可能需要一分鐘左右。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bereitet die Texterkennung für %@ noch vor. Das kann eine Minute dauern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS prépare encore la reconnaissance de texte pour %@. Cela peut prendre une minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
