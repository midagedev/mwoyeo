    "Text is read again only when the screen changes. A still screen uses almost no power.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 바뀔 때만 다시 읽습니다. 가만히 있는 화면은 전력을 거의 쓰지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面が変化したときだけテキストを読み直します。静止した画面ではほとんど電力を使いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在屏幕变化时才会重新读取文字。静止的屏幕几乎不耗电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在螢幕變化時才會重新讀取文字。靜止的螢幕幾乎不耗電。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text wird nur neu gelesen, wenn sich der Bildschirm ändert. Ein ruhender Bildschirm braucht fast keinen Strom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte n’est relu que lorsque l’écran change. Un écran immobile ne consomme presque rien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto solo se vuelve a leer cuando cambia la pantalla. Una pantalla quieta casi no consume energía."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст перечитывается только при изменении экрана. Неподвижный экран почти не расходует энергию."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto só é lido novamente quando a tela muda. Uma tela parada quase não consome energia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo viene riletto solo quando lo schermo cambia. Uno schermo fermo consuma quasi zero energia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст перечитується лише тоді, коли змінюється екран. Нерухомий екран майже не споживає енергії."
          }
        }
      }
    },
