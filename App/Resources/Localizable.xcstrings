        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放置透镜"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放置透鏡"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linse platzieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer une loupe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar una lupa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместить линзу"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posicionar uma lente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona una lente"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмістити лінзу"
          }
        }
      }
    },
    "Press %@ anywhere, then drag an area or click. The lens follows the window it lands on; hold ⌥ to pin it to the screen.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 %@를 누른 뒤 영역을 드래그하거나 클릭하세요. 렌즈는 놓인 창을 따라가고, ⌥를 누른 채 놓으면 화면에 고정됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも%@を押して、範囲をドラッグするかクリックします。レンズは置いたウインドウに追従し、⌥を押しながら置くと画面に固定されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意位置按下 %@，然后拖移选择区域或点按。透镜会跟随它所在的窗口；按住 ⌥ 可将其固定到屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何位置按下 %@，然後拖移選取範圍或點按。透鏡會跟隨它所在的視窗；按住 ⌥ 可將其固定在螢幕上。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %@ n’importe où, puis faites glisser une zone ou cliquez. La loupe suit la fenêtre où elle se pose ; maintenez ⌥ pour l’épingler à l’écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke überall %@ und ziehe dann einen Bereich auf oder klicke. Die Linse folgt dem Fenster, auf dem sie landet; halte ⌥, um sie an den Bildschirm zu heften."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ en cualquier lugar y arrastra un área o haz clic. La lupa sigue la ventana en la que cae; mantén ⌥ para fijarla a la pantalla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi %@ ovunque, poi trascina un’area o clicca. La lente segue la finestra su cui si posa; tieni premuto ⌥ per fissarla allo schermo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione %@ em qualquer lugar e arraste uma área ou clique. A lente segue a janela onde é colocada; mantenha ⌥ pressionada para fixá-la na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@ где угодно, затем выделите область или щёлкните. Линза следует за окном, на котором оказалась; удерживайте ⌥, чтобы закрепить её на экране."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть %@ будь-де, потім виділіть область або клацніть. Лінза слідує за вікном, на якому опинилася; утримуйте ⌥, щоб закріпити її на екрані."
          }
        }
      }
    },
    "Put a lens on the screen. The text under it is erased and rewritten in your language.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈를 올린 곳의 글자를 지우고, 그 자리에 번역을 다시 써요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面にレンズを置くと、その下のテキストが消えて、あなたの言語で書き直されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在屏幕上放置透镜，下方的文字会被擦除，并用你的语言重新书写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在螢幕上放置透鏡，下方的文字會被擦除，並用你的語言重新書寫。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzieren Sie eine Linse auf dem Bildschirm. Der Text darunter wird gelöscht und in Ihrer Sprache neu geschrieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez une loupe sur l’écran. Le texte dessous est effacé et réécrit dans votre langue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca una lupa en la pantalla. El texto que hay debajo se borra y se reescribe en tu idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместите линзу на экран. Текст под ней будет стёрт и написан заново на вашем языке."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posicione uma lente na tela. O texto sob ela é apagado e reescrito no seu idioma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona una lente sullo schermo. Il testo sottostante viene cancellato e riscritto nella tua lingua."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмістіть лінзу на екрані. Текст під нею буде стерто й написано наново вашою мовою."
          }
        }
      }
    },
    "Put a lens over anything you want to read\nand it translates right there.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽고 싶은 곳에 렌즈를 올리면\n그 자리에서 번역돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読みたいものにレンズを重ねると、\nその場で翻訳されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把透镜放在想读的内容上,\n就地翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把透鏡放在想讀的內容上,\n就地翻譯。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie eine Linse auf alles, was Sie lesen möchten,\nund es wird direkt dort übersetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez une loupe sur tout ce que vous voulez lire\net la traduction apparaît sur place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca una lupa sobre lo que quieras leer\ny se traduce justo ahí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместите линзу на всё, что хотите прочитать, —\nи перевод появится прямо на месте."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posicione uma lente sobre qualquer coisa que queira ler\ne ela é traduzida ali mesmo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona una lente su qualsiasi cosa tu voglia leggere\ne viene tradotta proprio lì."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмістіть лінзу на всьому, що хочете прочитати, —\nі переклад з’явиться просто на місці."
          }
        }
      }
    },
