          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo не може прочитати скопійований файл. Відкрийте його через «Відкрити…»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo 无法读取拷贝的文件，请改用“打开…”打开该文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
