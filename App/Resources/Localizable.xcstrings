    "Always shows translations on solid boxes. Uses the least battery": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 단색 상자 위에 번역을 띄웁니다. 배터리를 가장 적게 씁니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に単色のボックスの上に翻訳を表示します。バッテリー消費が最も少なくなります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终将译文显示在纯色块上。最省电"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一律將譯文顯示在純色塊上。最省電"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Übersetzungen immer auf einfarbigen Boxen. Geringster Akkuverbrauch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche toujours les traductions sur des boîtes unies. Consomme le moins de batterie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre muestra las traducciones sobre cuadros sólidos. Es lo que menos batería consume"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда показывает перевод на сплошных плашках. Меньше всего расходует заряд"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre mostra as traduções sobre caixas sólidas. Usa menos bateria"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra sempre le traduzioni su riquadri pieni. Consuma meno batteria"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди показує переклад на суцільних плашках. Найменше витрачає заряд"
