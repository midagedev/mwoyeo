    "Region in the middle of the lens. Arrow keys move it, Shift resizes, Return places it, Escape cancels.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereich in der Mitte der Linse. Pfeiltasten bewegen ihn, Umschalt ändert die Größe, Return platziert ihn, Escape bricht ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Región en el centro de la lente. Las flechas la mueven, Mayúsculas cambia el tamaño, Retorno la coloca, Escape cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone au centre de la loupe. Les flèches la déplacent, Maj la redimensionne, Retour la place, Échap annule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regione al centro della lente. Le frecce la spostano, Maiusc la ridimensiona, A capo la posiziona, Esc annulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領域はレンズの中央にあります。矢印キーで移動、Shiftでサイズ変更、Returnで配置、Escapeでキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역이 렌즈 가운데에 있습니다. 화살표 키로 옮기고, Shift로 크기를 바꾸고, Return으로 놓고, Escape로 취소합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Região no centro da lente. As setas a movem, Shift redimensiona, Return posiciona, Escape cancela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Область в центре линзы. Стрелки двигают её, Shift меняет размер, Return помещает, Escape отменяет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ділянка в центрі лінзи. Стрілки рухають її, Shift змінює розмір, Return розміщує, Escape скасовує."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区域位于透镜中央。方向键移动，Shift 调整大小，Return 放置，Escape 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域位於透鏡中央。方向鍵移動，Shift 調整大小，Return 放置，Escape 取消。"
          }
        }
      }
    },
