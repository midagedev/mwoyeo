    "Screen text is read, erased and translated on this Mac and never leaves it": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면의 글자는 이 Mac 안에서 읽고 지우고 번역하며, 밖으로 나가지 않습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の文字はこのMacの中で読み取り・消去・翻訳され、外に送られることはありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕文字在这台 Mac 上读取、擦除和翻译，绝不离开这台 Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
