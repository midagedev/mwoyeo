    "Forget the conversation kept for this app. Learned names stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergisst das für diese App gemerkte Gespräch. Gelernte Namen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvida la conversación guardada para esta app. Los nombres aprendidos se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublie la conversation conservée pour cette app. Les noms appris sont gardés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimentica la conversazione conservata per questa app. I nomi appresi restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリで記憶した会話を消去します。学習した名前は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에 대해 기억한 대화를 지웁니다. 배운 이름은 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquece a conversa guardada para este app. Os nomes aprendidos permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забывает диалог, сохранённый для этого приложения. Выученные имена остаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забуває діалог, збережений для цієї програми. Вивчені імена залишаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘记为此应用保留的对话。已学的名称会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "忘記為此 App 保留的對話。已學的名稱會保留。"
          }
        }
      }
    },
