          "stringUnit": {
            "state": "translated",
            "value": "wer war gestern Nacht wegen der Patchnotes noch wach?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "qui a veillé hier soir pour les notes de patch ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿quién se quedó despierto anoche por las notas del parche?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "chi è rimasto sveglio ieri sera per le patch notes?"
