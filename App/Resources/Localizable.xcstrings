    "That is the most. Remove a name to add another.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가득 찼습니다. 이름을 하나 지우면 더 넣을 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限です。名前を1つ削除すると追加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达上限。移除一个名称后才能再添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已達上限。移除一個名稱後才能再加入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist das Maximum. Entfernen Sie einen Namen, um einen neuen hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le maximum. Supprimez un nom pour en ajouter un autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el máximo. Elimina un nombre para añadir otro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это максимум. Удалите имя, чтобы добавить другое."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse é o máximo. Remova um nome para adicionar outro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il massimo. Rimuovi un nome per aggiungerne un altro."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це максимум. Видаліть ім’я, щоб додати інше."
          }
        }
      }
    },
