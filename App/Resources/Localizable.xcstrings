    "Follows this window. Click to pin the lens to the screen.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창을 따라갑니다. 누르면 화면에 고정합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウに追従しています。クリックすると画面に固定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在跟随此窗口。点按以将透镜固定到屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在跟隨此視窗。點按以將透鏡固定在螢幕上。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit cette fenêtre. Cliquez pour épingler la loupe à l’écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgt diesem Fenster. Klicken, um die Linse an den Bildschirm zu heften."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue esta ventana. Haz clic para fijar la lupa a la pantalla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue questa finestra. Clicca per fissare la lente allo schermo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue esta janela. Clique para fixar a lente na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
