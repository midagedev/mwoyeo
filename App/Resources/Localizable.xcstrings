    "Pinned to the screen. Click to follow the window underneath.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 고정됨. 누르면 아래 창을 따라갑니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に固定されています。クリックすると下のウインドウに追従します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已固定到屏幕。点按以跟随下方的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已固定在螢幕上。點按以跟隨下方的視窗。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An den Bildschirm angeheftet. Klicken, um dem darunterliegenden Fenster zu folgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épinglée à l’écran. Cliquez pour suivre la fenêtre en dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijada a la pantalla. Haz clic para seguir la ventana de debajo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплено на экране. Нажмите, чтобы следовать за окном под ним."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixada na tela. Clique para seguir a janela abaixo."
          }
        },
        "it": {
