    "ok who stayed up for the patch notes last night": {
      "comment": "A chat message in the onboarding demo, translated casually like a gamer chat",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어젯밤 패치 노트 보려고 안 잔 사람?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨夜パッチノート見るまで起きてた人いる？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨晚有谁熬夜等补丁说明的？"
