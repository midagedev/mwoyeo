    "Language packs are stored on this Mac and translate quickly, even offline.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 팩은 기기에 저장되어 오프라인에서도 빠르게 번역합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語パックはこのMacに保存され、オフラインでも素早く翻訳できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言包存储在这台 Mac 上，即使离线也能快速翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語言包儲存在這部 Mac 上，即使離線也能快速翻譯。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachpakete werden auf diesem Mac gespeichert und übersetzen schnell, auch offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les packs de langue sont stockés sur ce Mac et traduisent rapidement, même hors connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los paquetes de idioma se guardan en este Mac y traducen rápido, incluso sin conexión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Языковые пакеты хранятся на этом Mac и быстро переводят даже без интернета."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pacotes de idioma ficam armazenados neste Mac e traduzem rapidamente, até off-line."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pacchetti lingua sono salvati su questo Mac e traducono velocemente, anche offline."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мовні пакети зберігаються на цьому Mac і швидко перекладають навіть без інтернету."
          }
        }
      }
    },
