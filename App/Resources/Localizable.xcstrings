    "Apple Intelligence translates with context. For faster translation, get a language pack in Settings › Translation.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence로 문맥을 살려 번역해요. 더 빠른 번역은 설정 › 번역에서 언어 팩을 받으세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceは文脈を踏まえて翻訳します。より速く翻訳するには、設定 › 翻訳で言語パックを入手してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 会结合上下文进行翻译。若想更快，请在“设置 › 翻译”中获取语言包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 會依據上下文進行翻譯。若想更快，請在「設定 › 翻譯」中取得語言包。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence übersetzt mit Kontext. Für schnellere Übersetzungen laden Sie unter Einstellungen › Übersetzung ein Sprachpaket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence traduit en tenant compte du contexte. Pour traduire plus vite, téléchargez un pack de langue dans Réglages › Traduction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence traduce según el contexto. Para traducir más rápido, descarga un paquete de idioma en Ajustes › Traducción."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence переводит с учётом контекста. Для более быстрого перевода загрузите языковой пакет в Настройки › Перевод."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence traduz com contexto. Para traduzir mais rápido, baixe um pacote de idioma em Ajustes › Tradução."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence traduce tenendo conto del contesto. Per tradurre più velocemente, scarica un pacchetto lingua in Impostazioni › Traduzione."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence перекладає з урахуванням контексту. Для швидшого перекладу завантажте мовний пакет у Налаштування › Переклад."
          }
        }
      }
    },
