          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto lido pela lente é enviado para %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo letto dalla lente viene inviato a %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст, прочитаний лінзою, надсилається на %@."
          }
        }
      }
    },
    "That is the most names this app keeps.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에 담을 수 있는 이름이 가득 찼습니다."
