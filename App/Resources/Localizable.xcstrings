    "Applies only to engines you added. Apple Translation is not affected.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가한 엔진에만 적용됩니다. Apple 번역에는 영향이 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加したエンジンにのみ適用されます。Apple翻訳には影響しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于你添加的引擎，不影响 Apple 翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅適用於你加入的引擎，不影響 Apple 翻譯。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für Engines, die Sie hinzugefügt haben. Apple Übersetzung ist nicht betroffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique uniquement aux moteurs que vous avez ajoutés. Traduction Apple n’est pas concernée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aplica a los motores que has añadido. Traducción de Apple no se ve afectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует только для добавленных вами движков. Перевод Apple не затрагивается."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale só para os mecanismos que você adicionou. A Tradução da Apple não é afetada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale solo per i motori che hai aggiunto. Traduzione Apple non è interessata."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діє лише для рушіїв, які ви додали. Переклад Apple не змінюється."
          }
        }
      }
    },
