    "One \"original = translation\" per line. Apple Intelligence uses these exactly, and text recognition uses them as hints.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 하나씩 \"원문 = 번역\". Apple Intelligence가 이 번역을 그대로 쓰고, 화면 인식에도 힌트로 쓰입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行につき「原文 = 訳文」を1つ。Apple Intelligenceはこの訳をそのまま使い、テキスト認識でもヒントとして使われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一条“原文 = 译文”。Apple Intelligence 会原样采用，文字识别也会将其作为提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一條「原文 = 譯文」。Apple Intelligence 會原樣採用，文字辨識也會將其作為提示。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Zeile ein Eintrag „Original = Übersetzung“. Apple Intelligence verwendet sie unverändert, die Texterkennung nutzt sie als Hinweise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une paire « original = traduction » par ligne. Apple Intelligence les utilise telles quelles, et la reconnaissance de texte s’en sert comme indices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un «original = traducción» por línea. Apple Intelligence los usa tal cual y el reconocimiento de texto los usa como pistas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одной паре «оригинал = перевод» в строке. Apple Intelligence использует их без изменений, а распознавание текста — как подсказки."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um “original = tradução” por linha. O Apple Intelligence os usa exatamente, e o reconhecimento de texto os usa como dicas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un «originale = traduzione» per riga. Apple Intelligence li usa esattamente come sono e il riconoscimento del testo li usa come suggerimenti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "По одній парі «оригінал = переклад» у рядку. Apple Intelligence використовує їх без змін, а розпізнавання тексту — як підказки."
          }
        }
      }
    },
