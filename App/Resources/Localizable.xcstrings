    "Mwoyeo can no longer open its saving folder. Choose it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo kann seinen Speicherordner nicht mehr öffnen. Wähle ihn erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo ya no puede abrir su carpeta de guardado. Vuelve a elegirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo ne peut plus ouvrir son dossier d’enregistrement. Choisissez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo non riesce più ad aprire la cartella di salvataggio. Sceglila di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存フォルダを開けなくなりました。もう一度選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 폴더를 더 이상 열 수 없습니다. 다시 골라 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mwoyeo não consegue mais abrir a pasta de salvamento. Escolha-a novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo больше не может открыть папку для сохранения. Выберите её снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo більше не може відкрити теку для збереження. Виберіть її знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo 无法再打开其保存文件夹，请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo 無法再打開其儲存檔案夾，請重新選擇。"
          }
        }
      }
    },
    "Mwoyeo can’t read the copied file. Open the file with Open… instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo kann die kopierte Datei nicht lesen. Öffne sie stattdessen mit „Öffnen …“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo no puede leer el archivo copiado. Ábrelo con Abrir… en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo ne peut pas lire le fichier copié. Ouvrez-le plutôt avec Ouvrir…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo non riesce a leggere il file copiato. Aprilo invece con Apri…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたファイルを読めません。代わりに「開く…」でファイルを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 파일을 읽을 수 없습니다. 대신 열기…로 파일을 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mwoyeo não consegue ler o arquivo copiado. Abra-o com Abrir… em vez disso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
