    "Recent lines are sent too, for context.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Kontext werden auch die letzten Zeilen gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se envían las líneas recientes, como contexto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes récentes sont aussi envoyées, pour le contexte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono inviate anche le righe recenti, per il contesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文脈のため、直近の行も一緒に送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문맥을 위해 최근 줄도 함께 보냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas recentes também são enviadas, como contexto."
          }
        },
        "ru": {
