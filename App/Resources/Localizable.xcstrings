    "Mwoyeo needs Screen Recording permission.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록 권한이 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeoには画面収録の許可が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo 需要“屏幕录制”权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo 需要「螢幕錄製」權限。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo benötigt die Berechtigung „Bildschirmaufnahme“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo a besoin de l’autorisation « Enregistrement de l’écran »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo necesita el permiso de Grabación de pantalla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo требуется разрешение на запись экрана."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mwoyeo precisa da permissão de Gravação de Tela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo ha bisogno dell’autorizzazione per la Registrazione schermo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo потрібен дозвіл на запис екрана."
          }
        }
      }
    },
    "Mwoyeo uses Apple Translation. Get a language pack in Settings › Translation.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 번역을 사용해요. 설정 › 번역에서 언어 팩을 받아 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MwoyeoはApple翻訳を使用します。設定 › 翻訳で言語パックを入手してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo 使用 Apple 翻译。请在“设置 › 翻译”中获取语言包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo 使用 Apple 翻譯。請在「設定 › 翻譯」中取得語言包。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo verwendet Apple Übersetzung. Laden Sie unter Einstellungen › Übersetzung ein Sprachpaket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo utilise Traduction Apple. Téléchargez un pack de langue dans Réglages › Traduction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo usa Traducción de Apple. Descarga un paquete de idioma en Ajustes › Traducción."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo использует Перевод Apple. Загрузите языковой пакет в Настройки › Перевод."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mwoyeo usa a Tradução da Apple. Baixe um pacote de idioma em Ajustes › Tradução."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo usa Traduzione Apple. Scarica un pacchetto lingua in Impostazioni › Traduzione."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
