            "state": "translated",
            "value": "Текст, прочитанный линзой, отправляется на %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto lido pela lente é enviado para %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo letto dalla lente viene inviato a %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст, прочитаний лінзою, надсилається на %@."
