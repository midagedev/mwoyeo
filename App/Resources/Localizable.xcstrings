    "Translates text with the languages and the engine you set in Mwoyeo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzt Text mit den Sprachen und der Engine, die in Mwoyeo eingestellt sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce texto con los idiomas y el motor que ajustaste en Mwoyeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduit un texte avec les langues et le moteur réglés dans Mwoyeo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce il testo con le lingue e il motore impostati in Mwoyeo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo で設定した言語とエンジンでテキストを翻訳します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeo에서 정한 언어와 엔진으로 텍스트를 번역해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduz texto com os idiomas e o mecanismo definidos no Mwoyeo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводит текст с языками и движком, заданными в Mwoyeo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекладає текст із мовами та рушієм, заданими в Mwoyeo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用在 Mwoyeo 中设置的语言和引擎翻译文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用在 Mwoyeo 中設定的語言和引擎翻譯文字。"
          }
        }
      }
    },
    "Translates the screen in place, wherever you put a lens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzt den Bildschirm an Ort und Stelle, wo immer Sie eine Linse platzieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce la pantalla en el mismo lugar, dondequiera que pongas una lupa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduit l’écran sur place, partout où vous placez une loupe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce lo schermo sul posto, ovunque tu posizioni una lente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズを置いた場所を、その場で翻訳します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈를 올린 곳을, 그 자리에서 번역"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduz a tela no próprio lugar, onde quer que você posicione uma lente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводит экран прямо на месте — там, где вы поместили линзу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекладає екран прямо на місці — там, де ви розмістили лінзу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论透镜放在哪里，都就地翻译屏幕内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論透鏡放在哪裡，都就地翻譯螢幕內容。"
          }
        }
      }
    },
