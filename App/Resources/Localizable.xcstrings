    "Apple Intelligence translates with context. A lens offers a faster language pack when one helps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence übersetzt mit Kontext. Eine Linse bietet ein schnelleres Sprachpaket an, wenn es hilft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence traduce con contexto. Una lupa ofrece un paquete de idioma más rápido cuando ayuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence traduit avec le contexte. Une loupe propose un pack de langue plus rapide quand cela aide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence traduce tenendo conto del contesto. Una lente propone un pacchetto lingua più veloce quando serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceは文脈をふまえて翻訳します。役立つときは、レンズがより速い言語パックを提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence로 문맥을 살려 번역해요. 언어 팩이 더 빠를 때는 렌즈가 알려 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence traduz com contexto. Uma lente oferece um pacote de idioma mais rápido quando ajuda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence переводит с учётом контекста. Когда это поможет, линза предложит более быстрый языковой пакет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence перекладає з урахуванням контексту. Коли це допоможе, лінза запропонує швидший мовний пакет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 会结合上下文翻译。需要时，透镜会提供速度更快的语言包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 會結合上下文翻譯。需要時，透鏡會提供速度更快的語言包。"
          }
        }
      }
    },
