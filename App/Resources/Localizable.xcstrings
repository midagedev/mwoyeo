    "Colour, weight and size are matched to the original text.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 색과 굵기, 크기는 원문에서 읽어 맞춥니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の色、太さ、サイズは元のテキストに合わせます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字的颜色、粗细和大小会与原文保持一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字的顏色、粗細和大小會與原文保持一致。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbe, Stärke und Größe werden dem Originaltext angepasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur, l’épaisseur et la taille sont adaptées au texte d’origine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color, el grosor y el tamaño se ajustan al texto original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет, насыщенность и размер шрифта подбираются по оригиналу."
          }
        },
        "pt-BR": {
          "stringUnit": {
