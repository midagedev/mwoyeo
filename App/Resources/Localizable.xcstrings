    "Your engine's provider handles that text under its own privacy policy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter der Engine verarbeitet diesen Text nach seiner eigenen Datenschutzrichtlinie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor del motor trata ese texto según su propia política de privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur du moteur traite ce texte selon sa propre politique de confidentialité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fornitore del motore tratta quel testo secondo la propria informativa sulla privacy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送った文字は、エンジン提供元のプライバシーポリシーに従って扱われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낸 글자는 엔진 제공자의 개인정보 처리방침에 따라 처리됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor do mecanismo trata esse texto conforme a própria política de privacidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставщик движка обрабатывает этот текст по своей политике конфиденциальности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постачальник рушія обробляє цей текст за власною політикою конфіденційності."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送的文字由引擎提供方依据其隐私政策处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送的文字由引擎提供者依其隱私權政策處理。"
          }
        }
      }
    },
