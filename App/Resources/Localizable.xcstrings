    "Always erases the original and rewrites it": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 원문을 지우고 다시 씁니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に元のテキストを消して書き直します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
