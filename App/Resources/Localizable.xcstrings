    "No voice for %@ is installed. Add one in System Settings › Accessibility › Spoken Content.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 음성이 설치되어 있지 않습니다. 시스템 설정 › 손쉬운 사용 › 읽기 및 말하기에서 추가하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の音声がインストールされていません。システム設定 › アクセシビリティ › 読み上げコンテンツで追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装%@语音。请在“系统设置” › “辅助功能” › “朗读内容”中添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未安裝%@語音。請在「系統設定」› 「輔助使用」› 「語音內容」中加入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Stimme für %@ installiert. Füge eine unter Systemeinstellungen › Bedienungshilfen › Gesprochene Inhalte hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune voix n’est installée pour %@. Ajoutez-en une dans Réglages Système › Accessibilité › Contenu énoncé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna voz instalada para %@. Añade una en Ajustes del Sistema › Accesibilidad › Contenido leído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос для языка %@ не установлен. Добавьте его в Системных настройках › Универсальный доступ › Устный контент."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma voz para %@ está instalada. Adicione uma em Ajustes do Sistema › Acessibilidade › Conteúdo Falado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna voce per %@ è installata. Aggiungine una in Impostazioni di Sistema › Accessibilità › Contenuto letto ad alta voce."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос для мови %@ не встановлено. Додайте його в Системних параметрах › Доступність › Проговорений вміст."
          }
        }
      }
    },
