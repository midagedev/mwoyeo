          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ещё готовит распознавание текста для языка %@. Это может занять около минуты."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS ainda está preparando o reconhecimento de texto para %@. Isso pode levar um minuto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sta ancora preparando il riconoscimento del testo per %@. Può richiedere un minuto."
          }
        },
        "uk": {
