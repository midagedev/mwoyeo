    "Put a lens on the screen. The text under it is erased and rewritten in your language.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈를 올린 곳의 글자를 지우고, 그 자리에 번역을 다시 써요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面にレンズを置くと、その下のテキストが消えて、あなたの言語で書き直されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在屏幕上放置透镜，下方的文字会被擦除，并用你的语言重新书写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在螢幕上放置透鏡，下方的文字會被擦除，並用你的語言重新書寫。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzieren Sie eine Linse auf dem Bildschirm. Der Text darunter wird gelöscht und in Ihrer Sprache neu geschrieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez une loupe sur l’écran. Le texte dessous est effacé et réécrit dans votre langue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca una lupa en la pantalla. El texto que hay debajo se borra y se reescribe en tu idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместите линзу на экран. Текст под ней будет стёрт и написан заново на вашем языке."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posicione uma lente na tela. O texto sob ela é apagado e reescrito no seu idioma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona una lente sullo schermo. Il testo sottostante viene cancellato e riscritto nella tua lingua."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмістіть лінзу на екрані. Текст під нею буде стерто й написано наново вашою мовою."
          }
        }
      }
    },
    "Put a lens over anything you want to read\nand it translates right there.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽고 싶은 곳에 렌즈를 올리면\n그 자리에서 번역돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読みたいものにレンズを重ねると、\nその場で翻訳されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把透镜放在想读的内容上,\n就地翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把透鏡放在想讀的內容上,\n就地翻譯。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie eine Linse auf alles, was Sie lesen möchten,\nund es wird direkt dort übersetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez une loupe sur tout ce que vous voulez lire\net la traduction apparaît sur place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca una lupa sobre lo que quieras leer\ny se traduce justo ahí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместите линзу на всё, что хотите прочитать, —\nи перевод появится прямо на месте."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posicione uma lente sobre qualquer coisa que queira ler\ne ela é traduzida ali mesmo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona una lente su qualsiasi cosa tu voglia leggere\ne viene tradotta proprio lì."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмістіть лінзу на всьому, що хочете прочитати, —\nі переклад з’явиться просто на місці."
          }
        }
      }
    },
