    "Keep the part that stays the same, like a game’s name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie nur den Teil, der gleich bleibt, etwa den Namen eines Spiels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva solo la parte que no cambia, como el nombre de un juego."
          }
        },
