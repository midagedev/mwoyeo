        }
      }
    },
    "Mwoyeo can’t use the profile or the engine picked here any more. Pick another.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hier gewählte Profil oder die Engine ist nicht mehr verfügbar. Wähle eine andere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no se puede usar el perfil o el motor elegido aquí. Elige otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil ou le moteur choisi ici n’est plus utilisable. Choisissez-en un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo o il motore scelto qui non è più utilizzabile. Scegline un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで選んだプロファイルまたはエンジンはもう使えません。別のものを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 고른 프로필이나 엔진을 더는 쓸 수 없어요. 다른 것을 고르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil ou o mecanismo escolhido aqui não pode mais ser usado. Escolha outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный здесь профиль или движок больше недоступен. Выберите другой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний тут профіль або рушій більше недоступний. Виберіть інший."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法再使用这里选择的配置文件或引擎。请另选一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法再使用這裡選擇的設定檔或引擎。請另選一個。"
          }
        }
      }
    },
