    "Allowed. Mwoyeo reads only what is under a lens, and never stores or sends it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용됨. 렌즈 아래 글자만 읽고, 아무것도 저장하거나 보내지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されています。Mwoyeoはレンズの下の内容だけを読み取り、保存も送信もしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许。Mwoyeo 只会读取透镜下方的内容，绝不存储或发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許。Mwoyeo 只會讀取透鏡下方的內容，絕不儲存或傳送。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt. Mwoyeo liest nur, was unter einer Linse liegt, und speichert oder sendet nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisé. Mwoyeo ne lit que ce qui se trouve sous une loupe, et ne l’enregistre ni ne l’envoie jamais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido. Mwoyeo solo lee lo que hay bajo una lupa y nunca lo guarda ni lo envía."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешено. Mwoyeo читает только то, что находится под линзой, и ничего не сохраняет и не отправляет."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido. O Mwoyeo lê apenas o que está sob uma lente e nunca armazena nem envia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentito. Mwoyeo legge solo ciò che si trova sotto una lente e non lo salva né lo invia mai."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволено. Mwoyeo читає лише те, що під лінзою, і нічого не зберігає й не надсилає."
          }
        }
      }
    },
