    "Translates the screen in place, wherever you put a lens.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈를 올린 곳을, 그 자리에서 번역"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズを置いた場所を、その場で翻訳します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论透镜放在哪里，都就地翻译屏幕内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論透鏡放在哪裡，都就地翻譯螢幕內容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzt den Bildschirm an Ort und Stelle, wo immer Sie eine Linse platzieren."
          }
