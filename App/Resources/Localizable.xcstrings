    "This app keeps %lld names. Remove one to pin this.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에는 이름을 %lld개까지 담을 수 있습니다. 하나를 지우면 고정할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリには名前を%lld件まで保存できます。1つ削除すると固定できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用最多保存 %lld 个名称。移除一个后才能固定它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 最多儲存 %lld 個名稱。移除一個後才能固定它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App speichert %lld Namen. Entfernen Sie einen, um diesen zu fixieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app garde %lld noms. Supprimez-en un pour épingler celui-ci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app guarda %lld nombres. Elimina uno para fijar este."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение хранит не больше %lld имён. Удалите одно, чтобы закрепить это."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app guarda %lld nomes. Remova um para fixar este."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
