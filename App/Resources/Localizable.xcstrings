          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier tel qu’il était est conservé sous le nom settings.json.before-restore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file com’era prima viene conservato come settings.json.before-restore."
          }
