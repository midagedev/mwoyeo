    "%@ → %@ translation is not supported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ → %2$@ translation is not supported."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@ 번역은 지원되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から%@への翻訳はサポートされていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持 %@ → %@ 翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援 %@ → %@ 翻譯。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersetzung %@ → %@ wird nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction %@ → %@ n’est pas prise en charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se admite la traducción de %@ a %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод %@ → %@ не поддерживается."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há suporte para a tradução de %@ para %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione %@ → %@ non è supportata."
