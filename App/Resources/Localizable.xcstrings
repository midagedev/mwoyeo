            "value": "Nascondi lenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズを隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈 숨기기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar lentes"
          }
        },
