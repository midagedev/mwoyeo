          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As lentes continuam funcionando com um leitor mais simples."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lenti continuano a funzionare con una lettura più semplice."
          }
        },
        "uk": {
