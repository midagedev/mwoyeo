    "Press %@ anywhere, then drag an area or click. The lens follows the window it lands on; hold ⌥ to pin it to the screen.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 %@를 누른 뒤 영역을 드래그하거나 클릭하세요. 렌즈는 놓인 창을 따라가고, ⌥를 누른 채 놓으면 화면에 고정됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも%@を押して、範囲をドラッグするかクリックします。レンズは置いたウインドウに追従し、⌥を押しながら置くと画面に固定されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意位置按下 %@，然后拖移选择区域或点按。透镜会跟随它所在的窗口；按住 ⌥ 可将其固定到屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何位置按下 %@，然後拖移選取範圍或點按。透鏡會跟隨它所在的視窗；按住 ⌥ 可將其固定在螢幕上。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %@ n’importe où, puis faites glisser une zone ou cliquez. La loupe suit la fenêtre où elle se pose ; maintenez ⌥ pour l’épingler à l’écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke überall %@ und ziehe dann einen Bereich auf oder klicke. Die Linse folgt dem Fenster, auf dem sie landet; halte ⌥, um sie an den Bildschirm zu heften."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ en cualquier lugar y arrastra un área o haz clic. La lupa sigue la ventana en la que cae; mantén ⌥ para fijarla a la pantalla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi %@ ovunque, poi trascina un’area o clicca. La lente segue la finestra su cui si posa; tieni premuto ⌥ per fissarla allo schermo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione %@ em qualquer lugar e arraste uma área ou clique. A lente segue a janela onde é colocada; mantenha ⌥ pressionada para fixá-la na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@ где угодно, затем выделите область или щёлкните. Линза следует за окном, на котором оказалась; удерживайте ⌥, чтобы закрепить её на экране."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть %@ будь-де, потім виділіть область або клацніть. Лінза слідує за вікном, на якому опинилася; утримуйте ⌥, щоб закріпити її на екрані."
          }
        }
      }
    },
    "Provider default": {
      "localizations": {
