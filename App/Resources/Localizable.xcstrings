    "Lines before and after the text go to this engine, so names and tone stay consistent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilen vor und nach dem Text gehen an diese Engine, damit Namen und Ton einheitlich bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas antes y después del texto se envían a este motor, para que los nombres y el tono sean coherentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes avant et après le texte sont envoyées à ce moteur, pour que les noms et le ton restent cohérents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe prima e dopo il testo vanno a questo motore, così nomi e tono restano coerenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストの前後の行をこのエンジンに送るので、名前や口調が一貫します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞뒤 줄을 이 엔진에 함께 보내 이름과 말투가 일정하게 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas antes e depois do texto vão para este mecanismo, para que nomes e tom fiquem consistentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строки до и после текста отправляются этому движку, чтобы имена и тон оставались согласованными."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядки до й після тексту надсилаються цьому рушію, щоб імена й тон залишалися узгодженими."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字前后的行会发送给此引擎，让名称和语气保持一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
