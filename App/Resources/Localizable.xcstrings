    "The engine suggests the names and terms it translated, and Mwoyeo reuses them for that app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔진이 번역한 이름과 용어를 알려 주면 Mwoyeo가 그 앱에서 다시 씁니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンが翻訳した名前と用語を提案し、Mwoyeoがそのアプリで再利用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎会建议它翻译过的名称和术语，Mwoyeo 会在该应用中再次使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎會建議它翻譯過的名稱和術語，Mwoyeo 會在該 App 中再次使用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine schlägt die Namen und Begriffe vor, die sie übersetzt hat, und Mwoyeo verwendet sie für diese App erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur suggère les noms et termes qu’il a traduits, et Mwoyeo les réutilise pour cette app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor sugiere los nombres y términos que tradujo, y Mwoyeo los reutiliza para esa app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движок предлагает имена и термины, которые он перевёл, а Mwoyeo использует их для этого приложения повторно."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo sugere os nomes e termos que traduziu, e o Mwoyeo os reutiliza nesse app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore suggerisce i nomi e i termini che ha tradotto, e Mwoyeo li riutilizza per quell’app."
          }
        },
