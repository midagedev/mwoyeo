// Signing: ad-hoc by default. Ad-hoc signatures change on every build, so macOS re-asks for
// Screen Recording permission after each rebuild. Put a stable identity in Config/Local.xcconfig
// (git-ignored), e.g.
//   MWOYEO_SIGN_IDENTITY = <SHA-1 from `security find-identity -v -p codesigning`>
//   MWOYEO_TEAM = ABCDE12345
MWOYEO_SIGN_IDENTITY = -
MWOYEO_TEAM =
MWOYEO_PROFILE =

// The app's id. The reader services derive theirs from it (`<id>.reader.lines|docs`), and the app finds them by that name, so
// `xcodebuild … MWOYEO_APP_ID=<other id>` builds a re-identified app with its own re-identified services and caches.
MWOYEO_APP_ID = dev.midagedev.mwoyeo
MWOYEO_APP_ENTITLEMENTS = App/Mwoyeo.entitlements
MWOYEO_READER_ENTITLEMENTS = Reader/Reader.entitlements
MWOYEO_SCRIPT_ENTITLEMENTS = Script/Script.entitlements
#include? "Local.xcconfig"

// Extract localizable strings for the string catalog (xcstringstool sync).
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
