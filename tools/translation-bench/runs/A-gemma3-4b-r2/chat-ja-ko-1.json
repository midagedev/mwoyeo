":0,"stateless":false}],"context":[],"failed":[],"fallback":[],"items":[22,23,24],"latency_ms":2485,"layout":{"calibration":0.8956196059273724,"history_chars":0,"history_tok":0,"lcp_tok":52.232535417684495,"memory_tok":0,"stable_chars":213,"stable_tok":47.888780328936726,"volatile_chars":84,"volatile_tok":62.111219671063274},"n":8,"reply":"{\"translations\": [\"제발 그만해! 합숙에서 힘든 건 불가능해! 미나토는 괜찮은데\", \"그러니까, 료칸 근처에 온천이 있다고 하더라. 내 여동생도 가본 적이 있다고 해.\", \"정말? 가고 싶어!\"]}\n","screen":7,"terms_added":[],"usage":{"cached":0,"in":110,"out":69}},{"attempts":[{"latency_ms":1773,"ok":true,"retries":0,"stateless":false}],"context":[],"failed":[],"fallback":[],"items":[25,26,27],"latency_ms":1773,"layout":{"calibration":0.887366016517307,"history_chars":0,"history_tok":0,"lcp_tok":51.751186083289475,"memory_tok":0,"stable_chars":213,"stable_tok":47.44746090318052,"volatile_chars":75,"volatile_tok":53.55253909681947},"n":9,"reply":"{\"translations\": [\"저도 가고 싶어요! 제 오빠도 온천을 좋아하세요\",\"그래, 인터넷 확인하고 있어 놔두고\",\"알겠습니다. 아, 미나에게도 말해 줄게요\"]}","screen":8,"terms_added":[],"usage":{"cached":0,"in":101,"out":47}},{"attempts":[{"latency_ms":1352,"ok":true,"retries":0,"stateless":false}],"context":[],"failed":[],"fallback":[],"items":[28,29,30],"latency_ms":1352,"layout":{"calibration":0.9170653907496,"history_chars":0,"history_tok":0,"lcp_tok":53.48325358851681,"memory_tok":0,"stable_chars":213,"stable_tok":49.03548644338124,"volatile_chars":60,"volatile_tok":42.96451355661876},"n":10,"reply":"{\"translations\": [\"네! 기대돼요!\",\"한 교수님께도 연락해 봤어요\",\"답변이 곧 와요. 참석해 주신다고.\"]","screen":9,"terms_added":[],"usage":{"cached":0,"in":92,"out":35}},{"attempts":[{"latency_ms":1156,"ok":true,"retries":0,"stateless":false}],"context":[],"failed":[],"fallback":[],"items":[31,32],"latency_ms":1156,"layout":{"calibration":0.9526938239158987,"history_chars":0,"history_tok":0,"lcp_tok":55.56110381077536,"memory_tok":0,"stable_chars":213,"stable_tok":50.940538764783234,"volatile_chars":49,"volatile_tok":36.059461235216766},"n":11,"reply":"{\"translations\": [\"어떡해, 진짜야? 오겠어?\", \"저녁에는 도착한다고. 그 시간에 준비하자.\"]}\n","screen":10,"terms_added":[],"usage":{"cached":0,"in":87,"out":30}}],"translations":{"1":"모두, 이번 주말 합숙은 어떻게 할까?","10":"괜찮아, 우리들이 뒤를 따르는지라","11":"그래, 한 교수님도 불러보는 게 좋을까?","12":"어제, 연구실에서 만났어. 다음 주에 학회라고 하더라","13":"알았어. 그럼 동기 민토도 불러야지","14":"버스는 아침 8시에 출발 그러니까 늦지 않도록","15":"네, 조심하겠습니다!","16":"유우, 과자 담당 부탁해. 그리고 미나에게도 연락 시켜 줘","17":"알겠습니다. 미나 선배님은 뭐가 좋아요?","18":"초코! 그리고 해산물 술은 금지야","19":"음, 끔찍하다. 그래서 나는 커리 담당할 거야.","2":"나는 산이 좋겠어. 작년에는 물놀이에서 추웠고","20":"선배, 커리 잘 하세요?","21":"그래. 미나껀 매운 거 줄여줄게.","22":"제발 그만해! 합숙에서 힘든 건 불가능해! 미나토는 괜찮은데","23":"그러니까, 료칸 근처에 온천이 있다고 하더라. 내 여동생도 가본 적이 있다고 해.","24":"정말? 가고 싶어!","25":"저도 가고 싶어요! 제 오빠도 온천을 좋아하세요","26":"그래, 인터넷 확인하고 있어 놔두고","27":"알겠습니다. 아, 미나에게도 말해 줄게요","28":"네! 기대돼요!","29":"한 교수님께도 연락해 봤어요","3":"나도 산에 찬성입니다. 별을 보고 싶어요","30":"답변이 곧 와요. 참석해 주신다고.","31":"어떡해, 진짜야? 오겠어?","32":"저녁에는 도착한다고. 그 시간에 준비하자.","4":"별 인싸! 그럼 정했다는 거네","5":"숙하는 바다가 예약해 くれる 건가요?","6":"아, 이미 결제했어요. 두박스로 네만 원","7":"정말 저렴하네요! 감사합니다!","8":"유우는 처음 하는 합숙이잖아. 긴장하고 있어?","9":"네, 조금 뿐이야. 하지만 기대하고 있어."}}